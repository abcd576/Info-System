//Main Function
int main(){

    studentInfo student[5]; //no. of students: 5
    teacherInfo teacher[4]; //no. of teachers: 4
    staffInfo staff[3]; //no. of staff: 3

    int studentNo, teacherNo, staffNo;
    char loopCondition;

    printf("\n\nAccess Info? (y/n) : ");
    scanf("%c ", &loopCondition); 

    while(loopCondition == 'y' || loopCondition == 'Y'){  //carry loop

        char choice;
        printf("\n\nWhat would you like to access?\n");
        printf("Press: (s) for Student's Info. | (t) for Teacher's Info. | (S) for Staff Info.\n\n");
        scanf("%c", &choice);

        //Choice = (s) : Student
        if(choice == 's'){
            printf("Enter student number (1-5):");
            scanf("%d", &studentNo);

            accessStudentInformation(student, studentNo);
        
         }
    }
    
    // accessTeacherInformation(teacher);

    return 0;
}








