//Calculate CGPA
void calcCGPA(marks S1[], studentInfo student[], int i){
    // char choice; 
    // printf("Calculate CGPA? (y/n) ");
    // scanf(" %c", &choice);

    // if(choice == 'y'){
        printf("\nScore Range : (0-100)\n\n");
        printf("Enter Physics score: ");
        scanf("%f", &S1[i].phy);
        while(S1[i].phy > 100 || S1[i].phy < 0){
            printf("Invalid marks! Enter again (0-100): ");
            scanf("%f", &S1[i].phy);
        }

        printf("Enter Chemistry score: ");
        scanf("%f", &S1[i].chem);
        while(S1[i].chem > 100 || S1[i].chem < 0){
            printf("Invalid marks! Enter again (0-100): ");
            scanf("%f", &S1[i].chem);
        }

        printf("Enter Math score: ");
        scanf("%f", &S1[i].math);
        while(S1[i].math > 100 || S1[i].math < 0){
            printf("Invalid marks! Enter again (0-100): ");
            scanf("%f", &S1[i].math);
        }

        printf("Enter English score: ");
        scanf("%f", &S1[i].eng);
        while(S1[i].eng > 100 || S1[i].eng < 0){
            printf("Invalid marks! Enter again (0-100): ");
            scanf("%f", &S1[i].eng);
        }

        printf("Enter Computer score: ");
        scanf("%f", &S1[i].comp);
        while(S1[i].comp > 100 || S1[i].comp < 0){
            printf("Invalid marks! Enter again (0-100): ");
            scanf("%f", &S1[i].comp);
        }

// Grade Points 
float score, gpPhy, gpChem, gpMath, gpEng, gpComp;

gpPhy = calculateGradePoint(S1[i].phy);
gpChem = calculateGradePoint(S1[i].chem);
gpMath = calculateGradePoint(S1[i].math);
gpEng = calculateGradePoint(S1[i].eng);
gpComp = calculateGradePoint(S1[i].comp);

float cgpa = (gpPhy + gpChem + gpMath + gpEng + gpComp)/5;
student[i].cgpa = cgpa;
printf("\nCGPA : %.2f\n", cgpa);
    

}

float calculateGradePoint(float score) {
        if(score >= 91) return 10;
        else if(score >= 81) return 9;
        else if(score >= 71) return 8;
        else if(score >= 61) return 7;
        else if(score >= 51) return 6;
        else if(score >= 41) return 5;
        else if(score >= 33) return 4;
        else return 0;
}
    



