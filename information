//Data Storage of Students, Teachers and Staff 
#include<stdio.h>
#include<string.h>

//student info.
typedef struct studentInformation{
    char name[50];
    char email[100];
    float cgpa;
    int semester;
    char dept[30];
    char section;
}studentInfo;

//teacher's info
typedef struct teacherInformation{
    char name[50];
    char email[100];
    char dept[30];
    int teachingYear;
}teacherInfo;

//staff info
typedef struct staffInformation{
    char name[50];
    char desig[50];
    int workYear;
}staffInfo;

