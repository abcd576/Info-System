//Main Function
int main(){

    //Structure array 
    studentInfo student[5]; //no. of students: 5
    teacherInfo teacher[4]; //no. of teachers: 4
    staffInfo staff[3]; //no. of staff: 3

    //marks
    marks S1[5];

    //ID Numbers
    int studentNo, teacherNo, staffNo;
    char loopCondition = 'y';

    //Start
    
    while(loopCondition == 'y' || loopCondition == 'Y'){  //carry loop

        char choice;
        printf("\nWhat would you like to access?\n\n");
        printf("Press: (s) for Student's Info. | (t) for Teacher's Info. | (S) for Staff Info. -  ");
        scanf(" %c", &choice);

        //Choice = (s) : Student
        if(choice == 's'){
            printf("\nEnter student ID number (1-5): ");
            scanf("%d", &studentNo);

            while(studentNo < 1 || studentNo > 5){
                printf("Invalid Entry! Enter again\n");
                printf("\nEnter student ID number (1-5): ");
                scanf("%d", &studentNo);
            }
            accessStudentInformation(student, S1, studentNo);
            

        
         }

        //Choice = (t) : Teacher
        else if(choice == 't'){
            printf("\nEnter teacher ID number (1-4): ");
            scanf("%d", &teacherNo);
            // if(teacherNo >= 1 && teacherNo <= 4){
            // } else {
            //     printf("Invalid Entry!\n");
            // }
            while(teacherNo < 1 || teacherNo > 4){
                printf("Invalid Entry! Enter again\n");
                printf("\nEnter teacher ID number (1-4): ");
                scanf("%d", &teacherNo);
            }
            accessTeacherInformation(teacher, teacherNo);

            
        
         }
    
         //Choice = (S) : Staff
        else if(choice == 'S'){
            printf("\nEnter staff ID number (1-3): ");
            scanf("%d", &staffNo);
            // if(staffNo >= 1 && staffNo <= 3){
            // } else {
            //     printf("Invalid Entry!\n");
            // }
            while(staffNo < 1 || staffNo > 3){
                printf("Invalid Entry! Enter again\n");
                printf("\nEnter staff ID number (1-3): ");
                scanf("%d", &staffNo);
            }
            accessStaffInformation(staff, staffNo);

        
         }

         else{
            printf("\nInvalid Entry!\n");
         }

         printf("\nAccess more info? (y/n) : ");
         scanf(" %c", &loopCondition); 
}
    
    printf("\nThank You!\n\n");


    return 0;
}








